# Public base URL, used for og:image and the embed snippet
SITE_URL=http://localhost:3000

# /admin password. Required for /admin and the admin API.
ADMIN_PASSWORD=change-me

# The poll on the block, read from X (read only). The account that posts the polls.
X_BEARER_TOKEN=
X_ACCOUNT=crimeislegalpf

# The investigation under way, read from the `progress` branch of the repository when no store is configured.
GITHUB_REPO=frieshimself-cpu/sniper

# Where the site keeps its own state (disputes, leads). Default: web/.data
CRIME_STATE_DIR=

# Shared state with the agent. Set by the Upstash integration on Vercel, or Turso. Files under web/.data when unset.
KV_REST_API_URL=
KV_REST_API_TOKEN=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# The curtain. Hosts that show /coming-soon until release; PREVIEW_KEY in ?preview= lifts it for one browser.
COMING_SOON_HOSTS=
PREVIEW_KEY=
