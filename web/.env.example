# Public base URL, used for og:image and the embed snippet
SITE_URL=http://localhost:3000

# /admin password. Required for /admin and the admin API.
ADMIN_PASSWORD=change-me

# Voting. A vote is accepted only from a wallet holding >= MIN_VOTE_BALANCE of CRIME_MINT.
CRIME_MINT=
MIN_VOTE_BALANCE=1000
HELIUS_API_KEY=
# Optional full RPC URL. Overrides HELIUS_API_KEY if set.
SOLANA_RPC_URL=
# Dev only. "off" skips the balance check so you can vote with any wallet on demo data.
VOTE_BALANCE_CHECK=on

# A token is eligible for the ballot when its case score is at or above this.
BALLOT_SCORE_THRESHOLD=40

# Where the site keeps its own state (ballots, votes, disputes). Default: web/.data
CRIME_STATE_DIR=

# Shared state with the agent. Set by the Upstash integration on Vercel. Files under web/.data when unset.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Ballots. The agent posts the hour's ballot (as a poll on X when configured); the site only shows it.
# "on" lets the site build a ballot itself when none exists, which is right for a server without the agent's cycle.
BALLOT_AUTOBUILD=on
BALLOT_PERIOD_HOURS=1
# "archive" takes ballot options from the archive instead of fresh launches (the tests use this).
BALLOT_SOURCE=discovery
