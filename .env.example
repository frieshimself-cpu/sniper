# Agent keys. The investigator needs Helius. Arkham and Grok are optional and add attribution.
HELIUS_API_KEY=
ARKHAM_API_KEY=
XAI_API_KEY=
XAI_MODEL=grok-4.3
# Grok through a reseller that takes crypto (OpenRouter): posts are still read and classified; X live search is off.
# XAI_BASE_URL=https://openrouter.ai/api/v1

# How often the watcher opens a case, in hours.
INVESTIGATE_INTERVAL_HOURS=6
# A subject below this score gets no case. Nothing found means nothing published.
MIN_PUBLISH_SCORE=35

# When the ballot has no winner and the watchlist is empty, scan this many boosted tokens (DexScreener) and keep the worst.
DISCOVER_SCAN=6
# Space between Helius requests, in ms. 130 keeps a free key under its limit.
HELIUS_MIN_GAP_MS=130

# The hourly cycle. Polls go to X when these four are set (developer.x.com, Read and Write).
# X, either way in. OAuth 1.0a (never expires):
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# or OAuth 2.0 (the agent refreshes the user token and keeps the rotated pair in shared state):
X_CLIENT_ID=
X_CLIENT_SECRET=
X_USER_TOKEN=
X_REFRESH_TOKEN=
# app-only, used for reads with either:
X_BEARER_TOKEN=
# The account whose polls the agent reads. It never writes to it.
X_ACCOUNT=crimeislegalpf
# A poll still open but closing within this many minutes is waited for.
POLL_WAIT_MINUTES=15
# Without votes nothing is opened. "off" investigates the top option anyway.
REQUIRE_VOTES=on
# Where the site lives, for links in posts.
SITE_URL=https://frieshimself-cpu.github.io/sniper

# Shared state with the site (the store attached to the Vercel project). Files under web/.data when unset.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# A person's case: how far back to read, how many tokens to replay.
PERSON_MAX_POSTS=200
PERSON_MAX_TOKENS=5
PERSON_MAX_WALLETS=12
